{
  "name": "stafura-dev",
  "private": true,
  "description": "Source for stafura.dev (Hugo + Tailwind CSS)",
  "scripts": {
    "dev": "tailwindcss -i ./styles/main.css -o ./assets/css/site.css --watch",
    "build": "tailwindcss -i ./styles/main.css -o ./assets/css/site.css --minify",
    "build:site": "hugo -d public"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.2.0",
    "@fontsource-variable/geist-mono": "^5.2.0",
    "@tailwindcss/cli": "^4.1.0",
    "@tailwindcss/typography": "^0.5.16",
    "hugo-bin": "^0.163.0",
    "tailwindcss": "^4.1.0"
  }
}
